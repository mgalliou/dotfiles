#!/usr/bin/env sh
# Rename a file or directory within its current parent directory.

set -eu

usage() {
	echo "Usage: ${0##*/} <path> <new-name>" >&2
}

if [ "$#" -ne 2 ]; then
	usage
	exit 1
fi

case $2 in
*/*)
	echo "${0##*/}: new-name must not contain '/'" >&2
	exit 1
	;;
esac

mv -i -- "$1" "$(dirname -- "$1")/$2"
